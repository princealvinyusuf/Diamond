APP_NAME="Diamond"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/Diamond/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=operations
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=diamond
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
CACHE_STORE=database

# Immutable safety controls. LIVE execution is intentionally unsupported.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
MOCK_DATA_ENABLED=true
DEFAULT_SYMBOL=XAUUSD
DEFAULT_TIMEFRAME=H4
STRATEGY_VERSION=h4-gold-v1.0.0-paper

# Read-only data. Mock fixtures are the safe default; Twelve Data never executes trades.
MARKET_DATA_PROVIDER=mock
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
MARKET_MAX_QUOTE_AGE_SECONDS=300
MARKET_MAX_FUTURE_SKEW_SECONDS=30
MARKET_MAX_SPREAD=1.0
PROVIDER_CONNECT_TIMEOUT_SECONDS=3
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_RETRY_ATTEMPTS=2
PROVIDER_RETRY_DELAY_MS=250
PROVIDER_STALE_AFTER_MINUTES=10

RATE_LIMIT_ANALYSIS_PER_MINUTE=12
RATE_LIMIT_BACKTESTS_PER_MINUTE=5
RATE_LIMIT_PAPER_PER_MINUTE=30
MISSED_H4_AFTER_MINUTES=20

# Paper-fill model. Spread is already embedded in provider bid/ask and is never deducted again.
PAPER_CONTRACT_SIZE=100
PAPER_SLIPPAGE_PRICE=0.05
PAPER_COMMISSION_ROUND_TRIP_PER_LOT=7
PAPER_LOSS_COOLDOWN_MINUTES=1440
PAPER_VOLUME_MIN=0.01
PAPER_VOLUME_MAX=100
PAPER_VOLUME_STEP=0.01

# Historical replay worker only; no broker or live execution capability.
BACKTEST_PYTHON=python
ANALYSIS_PYTHON=python
ANALYSIS_TIMEOUT_SECONDS=10
